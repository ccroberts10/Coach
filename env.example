# ===== Coach env vars =====

# Server
PORT=3000
TZ=America/Denver
REDIRECT_URI=https://coach-production.up.railway.app
DB_PATH=/data/coach.db

# WHOOP — get from https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Strava — create app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Anthropic — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Pushover (you already have these from SIGNAL)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional weather
OPENWEATHER_KEY=

# ===== Personal benchmarks (override auto-estimates) =====
FTP=                  # cycling watts at threshold
MAX_HR=               # max heart rate
LTHR=                 # lactate threshold HR
RHR_BASELINE=55       # from WHOOP
HRV_BASELINE=54       # from WHOOP
BODYWEIGHT_KG=80
SQUAT_1RM=            # in lbs
DEADLIFT_1RM=
BENCH_1RM=
WEEKLY_HOURS=10       # target training hours/week
PRIMARY_FOCUS=cycling-balanced
LOCATION=Durango, CO
